# ============================================================
# 前端栈环境变量（部署在 Web 服务器，与 frontend/docker-compose.yml 同目录）
# 使用方法：cp .env.example .env 然后修改下面的值
# ============================================================

# 后端 API 地址（前端服务器到后端服务器的可达地址，不要带尾斜杠）
# 示例：
#   - 公网域名： https://api.example.com
#   - 内网 IP：  http://10.0.0.5:8000
BACKEND_URL=http://api.example.com:8000

# 前端对外端口
WEB_PORT=8080
