# ============================================================
# 后端栈环境变量（部署在 API 服务器，与 docker-compose.yml 同目录）
# 使用方法：cp .env.example .env 然后修改下面的值
# ============================================================

# ---- 阿里云百炼 ----
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.5-plus
DASHSCOPE_LITE_MODEL=qwen-turbo

# 前端可选模型白名单（逗号分隔，留空则只用上面两个）。务必只填你账号实际开通的模型！
DASHSCOPE_MODELS=qwen3.5-plus,qwen-plus,qwen-turbo,qwen-max

# ---- MySQL ----
DB_PORT=3306
DB_PASSWORD=changeme123
DB_NAME=quotation

# ---- 连接池 / 并发（性能调优，可选） ----
# 总连接数 ≈ UVICORN_WORKERS ×（DB_POOL_SIZE + DB_MAX_OVERFLOW），需 ≤ MySQL max_connections
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# uvicorn worker 数：2 核 2G 建议 1~2，内存吃紧设为 1
UVICORN_WORKERS=1

# ---- Meilisearch ----
MEILI_MASTER_KEY=changeme-meili-master-key
MEILI_ENV=production

# ---- JWT ----
JWT_SECRET=changeme-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- 后端对外端口（前端服务器从这里访问） ----
BACKEND_PORT=8000

# ---- CORS 白名单 ----
# 多个域名用英文逗号分隔，例：https://web.example.com,http://192.168.1.10
# 开发期可填 *（不建议生产用）
CORS_ORIGINS=*
