# ============================================================
# 后端栈环境变量（部署在 API 服务器，与 docker-compose.yml 同目录）
# 使用方法：cp .env.example .env 然后修改下面的值
# ============================================================

# ---- 阿里云百炼 ----
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.5-plus
DASHSCOPE_LITE_MODEL=qwen-turbo

# ---- MySQL ----
DB_PORT=3306
DB_PASSWORD=changeme123
DB_NAME=quotation

# ---- Meilisearch ----
MEILI_MASTER_KEY=changeme-meili-master-key
MEILI_ENV=production

# ---- JWT ----
JWT_SECRET=changeme-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- 后端对外端口（前端服务器从这里访问） ----
BACKEND_PORT=8000

# ---- CORS 白名单 ----
# 多个域名用英文逗号分隔，例：https://web.example.com,http://192.168.1.10
# 开发期可填 *（不建议生产用）
CORS_ORIGINS=*
