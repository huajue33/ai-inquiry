DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.5-plus
DASHSCOPE_LITE_MODEL=qwen-turbo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quotation

# 连接池 / 并发（性能调优，可选）
# 总连接数 ≈ UVICORN_WORKERS ×（DB_POOL_SIZE + DB_MAX_OVERFLOW），需 ≤ MySQL max_connections
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
UVICORN_WORKERS=1

MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=your-master-key-change-me

JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
